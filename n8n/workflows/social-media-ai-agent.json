      "id": "1",
      "name": "Incoming Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        280
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "2",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        520
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "3",
      "name": "Merge Triggers",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        470,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $json;\nconst fromWebhook = !!item.body || !!item.headers;\n\nif (fromWebhook) {\n  const body = item.body || {};\n  return [{\n    json: {\n      triggerType: body.triggerType || 'incoming_message',\n      platform: (body.platform || 'facebook').toLowerCase(),\n      senderId: body.senderId || '',\n      messageText: body.messageText || '',\n      eventType: body.eventType || 'dm',\n      receivedAt: new Date().toISOString(),\n      raw: body\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    triggerType: 'scheduled_post',\n    platform: 'instagram',\n    senderId: 'system',\n    messageText: 'Generate a scheduled design tip post caption.',\n    eventType: 'schedule',\n    receivedAt: new Date().toISOString(),\n    raw: item\n  }\n}];"
      },
      "id": "4",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        400
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.triggerType}}",
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value2": "incoming_message"
            },
            {
              "operation": "equal",
              "value2": "scheduled_post"
            },
            {
              "operation": "equal",
              "value2": "mention_event"
            }
          ]
        },
        "fallbackOutput": 3
      },
      "id": "5",
      "name": "Route Trigger Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        920,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processingMode",
              "value": "conversation_reply",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6",
