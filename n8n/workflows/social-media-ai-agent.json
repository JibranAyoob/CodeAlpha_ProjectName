    {
      "parameters": {
        "mode": "append"
      },
      "id": "9",
      "name": "Merge Context",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1400,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = {\n  brandName: $env.BRAND_NAME || 'Your Design Studio',\n  brandVoice: $env.BRAND_VOICE || 'friendly professional',\n  portfolioUrl: $env.PORTFOLIO_URL || '',\n  bookingUrl: $env.BOOKING_URL || '',\n  availability: $env.AVAILABILITY_MESSAGE || ''\n};\n\nconst input = $json.messageText || '';\n\nconst systemPrompt = `You are an AI assistant for ${b.brandName}. Tone: ${b.brandVoice}. Keep responses concise and include CTA where relevant.`;\n\nconst userPrompt = `Platform: ${$json.platform}\\nMode: ${$json.processingMode}\\nMessage: ${input}\\nPortfolio: ${b.portfolioUrl}\\nBooking: ${b.bookingUrl}\\nAvailability: ${b.availability}`;\n\nreturn [{ json: { ...$json, systemPrompt, userPrompt } }];"
      },
      "id": "10",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AI_API_BASE_URL + '/chat/completions'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { model: $env.AI_MODEL || 'gpt-4o-mini', temperature: Number($env.AI_TEMPERATURE || 0.4), max_tokens: Number($env.AI_MAX_TOKENS || 500), messages: [ { role: 'system', content: $json.systemPrompt }, { role: 'user', content: $json.userPrompt } ] } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "11",
      "name": "Call AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1880,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json;\nconst content = raw?.choices?.[0]?.message?.content || 'Thanks for your message. I can help with your design needs.';\n\nreturn [{\n  json: {\n    ...$item(0).$node['Build Prompt'].json,\n    aiRaw: raw,\n    responseText: String(content).slice(0, 1800),\n    ctaUrl: $env.BOOKING_URL || '',\n    leadScore: 50,\n    manualReview: false\n  }\n}];"
      },
      "id": "12",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        400
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.platform}}",
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value2": "facebook"
            },
            {
              "operation": "equal",
              "value2": "instagram"
            },
            {
              "operation": "equal",
              "value2": "whatsapp"
            },
            {
              "operation": "equal",
              "value2": "linkedin"
            }
          ]
        },
        "fallbackOutput": 4
      },
      "id": "13",
      "name": "Platform Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2360,
